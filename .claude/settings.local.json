{
  "permissions": {
    "allow": [
      "Bash(bash --version)",
      "Bash(jq --version)",
      "Bash(bash ~/.claude/statusline-command.sh)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(node -e ' *)",
      "Bash(git checkout *)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"[System.Media.SystemSounds]::Asterisk.Play()\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"[System.Media.SystemSounds]::Question.Play()\""
          }
        ]
      }
    ]
  }
}

